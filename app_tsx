'use client'

import { useState } from 'react'
import {
  ArrowLeft,
  ArrowRight,
  Bot,
  Check,
  ChevronRight,
  Code2,
  Command,
  Send,
  Sparkles,
  Timer,
} from 'lucide-react'
import { Button } from '@/components/ui/button'
import { SetupScreen } from './setup-screen'
import { InterviewScreen, type ChatMessage } from './interview-screen'
import { FeedbackScreen } from './feedback-screen'

type Experience = 'Estágio' | 'Júnior' | 'Pleno'
type Screen = 'setup' | 'interview' | 'feedback'

const interviewQuestions = [
  'Legal! Para começar, como você explicaria a diferença entre uma lista e uma pilha? Em que situação escolheria cada estrutura?',
  'Imagine que uma API começou a responder lentamente. Como você investigaria o problema antes de propor uma solução?',
  'O que acontece quando duas threads tentam acessar e alterar o mesmo recurso ao mesmo tempo? Como você evitaria inconsistências?',
  'Como você costuma testar uma função que depende de um serviço externo, como um banco de dados ou uma API?',
]

const recruiterReplies = [
  'Boa linha de raciocínio. Vamos aprofundar um pouco mais nesse tema.',
  'Entendi. Obrigado por explicar seu processo — vamos para a próxima.',
  'Ótimo ponto. Agora quero explorar como você aplicaria isso no dia a dia.',
  'Obrigado pela resposta! Tenho mais uma pergunta para fechar a conversa.',
]

export function TechMockApp() {
  const [screen, setScreen] = useState<Screen>('setup')
  const [name, setName] = useState('')
  const [role, setRole] = useState('')
  const [technologies, setTechnologies] = useState('')
  const [experience, setExperience] = useState<Experience>('Estágio')
  const [messages, setMessages] = useState<ChatMessage[]>([])
  const [replyCount, setReplyCount] = useState(0)
  const [isTyping, setIsTyping] = useState(false)

  function startSimulation() {
    setMessages([
      {
        id: 0,
        role: 'recruiter',
        text: `Olá, ${name.trim()}! Que bom ter você por aqui. Vamos conversar sobre a vaga de ${role.trim() || 'Engenharia de Software'}. Para começar: conte um pouco sobre um projeto em que você usou ${technologies.trim() || 'tecnologia'} e qual foi o maior desafio.`,
      },
    ])
    setReplyCount(0)
    setIsTyping(false)
    setScreen('interview')
  }

  function sendAnswer(text: string) {
    const answer = text.trim()
    if (!answer || replyCount >= 5 || isTyping) return

    const nextReplyCount = replyCount + 1
    setMessages((current) => [
      ...current,
      { id: Date.now(), role: 'candidate', text: answer },
    ])
    setReplyCount(nextReplyCount)

    if (nextReplyCount < 5) {
      setIsTyping(true)
      window.setTimeout(() => {
        const questionIndex = nextReplyCount - 1
        setMessages((current) => [
          ...current,
          {
            id: Date.now() + 1,
            role: 'recruiter',
            text: `${recruiterReplies[questionIndex]} ${interviewQuestions[questionIndex]}`,
          },
        ])
        setIsTyping(false)
      }, 850)
    }
  }

  function resetSimulation() {
    setScreen('setup')
    setName('')
    setRole('')
    setTechnologies('')
    setExperience('Estágio')
    setMessages([])
    setReplyCount(0)
    setIsTyping(false)
  }

  const screenLabel = screen === 'setup' ? 'Preparação' : screen === 'interview' ? 'Entrevista' : 'Feedback'

  return (
    <main className="app-shell min-h-screen overflow-hidden text-slate-100">
      <div className="ambient ambient-one" aria-hidden="true" />
      <div className="ambient ambient-two" aria-hidden="true" />
      <div className="app-grid" aria-hidden="true" />

      <div className="relative z-10 mx-auto flex min-h-screen w-full max-w-7xl flex-col px-5 sm:px-8">
        <header className="flex h-[76px] shrink-0 items-center justify-between border-b border-white/[0.07]">
          <a href="#inicio" className="flex items-center gap-3" aria-label="TechMock, início">
            <span className="brand-mark flex size-10 items-center justify-center rounded-xl text-emerald-300">
              <Code2 size={20} strokeWidth={2.2} />
            </span>
            <span className="text-[17px] font-semibold tracking-[-0.04em] text-white">Tech<span className="text-emerald-300">Mock</span></span>
          </a>

          <div className="hidden items-center gap-2 rounded-full border border-white/[0.08] bg-white/[0.035] px-3.5 py-2 sm:flex">
            <span className="relative flex size-2">
              <span className="absolute inline-flex size-full animate-ping rounded-full bg-emerald-400 opacity-40" />
              <span className="relative inline-flex size-2 rounded-full bg-emerald-400" />
            </span>
            <span className="text-xs font-medium text-slate-300">Prática sem pressão</span>
          </div>

          <div className="flex items-center gap-2 text-xs font-medium text-slate-500">
            <span className="hidden sm:inline">Sessão de</span>
            <span className="text-slate-300">{screenLabel}</span>
            <ChevronRight size={14} aria-hidden="true" />
          </div>
        </header>

        <div className="flex flex-1 flex-col justify-center py-10 sm:py-14">
          <div key={screen} className="screen-transition w-full">
            {screen === 'setup' && (
              <SetupScreen
                name={name}
                role={role}
                technologies={technologies}
                experience={experience}
                onNameChange={setName}
                onRoleChange={setRole}
                onTechnologiesChange={setTechnologies}
                onExperienceChange={setExperience}
                onStart={startSimulation}
              />
            )}
            {screen === 'interview' && (
              <InterviewScreen
                role={role}
                technologies={technologies}
                experience={experience}
                messages={messages}
                replyCount={replyCount}
                isTyping={isTyping}
                onSend={sendAnswer}
                onFinish={() => setScreen('feedback')}
                onBack={() => setScreen('setup')}
              />
            )}
            {screen === 'feedback' && (
              <FeedbackScreen
                role={role}
                technologies={technologies}
                experience={experience}
                onReset={resetSimulation}
              />
            )}
          </div>
        </div>

        <footer className="flex min-h-14 items-center justify-between border-t border-white/[0.07] text-[11px] text-slate-500">
          <span className="flex items-center gap-2"><Command size={13} /> Um espaço seguro para praticar.</span>
          <span className="hidden items-center gap-1.5 sm:flex"><Timer size={13} /> Simulação de aproximadamente 10 min</span>
          <span className="flex items-center gap-1.5"><Sparkles size={13} className="text-emerald-400" /> Feito para você evoluir</span>
        </footer>
      </div>
    </main>
  )
}
